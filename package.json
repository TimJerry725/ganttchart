{
  "name": "iris-gantt",
  "version": "1.3.7",
  "description": "A comprehensive, production-ready Gantt chart component built with React and TypeScript. Easy to install, simple to use.",
  "keywords": [
    "gantt",
    "gantt-chart",
    "react",
    "typescript",
    "project-management",
    "timeline",
    "scheduling",
    "task-management"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TimJerry725/ganttchart.git"
  },
  "type": "module",
  "main": "./dist/iris-gantt.umd.cjs",
  "module": "./dist/iris-gantt.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "default": "./dist/iris-gantt.js"
      },
      "require": {
        "default": "./dist/iris-gantt.umd.cjs"
      }
    },
    "./gantt.css": {
      "import": "./dist/gantt.css",
      "require": "./dist/gantt.css",
      "default": "./dist/gantt.css"
    },
    "./dist/gantt.css": {
      "import": "./dist/gantt.css",
      "require": "./dist/gantt.css",
      "default": "./dist/gantt.css"
    }
  },
  "files": [
    "dist",
    "README.md",
    "USAGE.md",
    "QUICK_START.md",
    "PACKAGE_SETUP.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "0.2.2",
    "@react-google-maps/api": "2.19.3",
    "@tanstack/react-query": "5.51.9",
    "antd": "5.19.2",
    "dayjs": "^1.11.0",
    "echarts-for-react": "3.0.2",
    "react": "18.3.1",
    "react-apexcharts": "1.4.1",
    "react-beautiful-dnd": "13.1.1",
    "react-chartjs-2": "5.2.0",
    "react-cool-onclickoutside": "1.7.0",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "18.3.1",
    "react-draggable": "4.4.6",
    "react-google-charts": "4.0.1",
    "react-google-places-autocomplete": "4.1.0",
    "react-icons": "5.2.1",
    "react-phone-input-2": "2.15.1",
    "react-router": "6.25.1",
    "react-router-dom": "6.25.1",
    "react-toastify": "10.0.5",
    "react-tooltip": "5.28.0"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@eslint/js": "^9.39.1",
    "@storybook/addon-a11y": "^10.2.11",
    "@storybook/addon-docs": "^10.2.11",
    "@storybook/addon-onboarding": "^10.2.11",
    "@storybook/addon-vitest": "^10.2.11",
    "@storybook/react-vite": "^10.2.11",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "0.2.2",
    "@types/d3-dispatch": "^3.0.7",
    "@types/google-map-react": "2.1.10",
    "@types/node": "^24.10.1",
    "@types/react": "18.3.5",
    "@types/react-beautiful-dnd": "13.1.8",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "@vitest/browser-playwright": "^4.0.17",
    "@vitest/coverage-v8": "^4.0.17",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.7",
    "antd": "5.19.2",
    "dayjs": "^1.11.0",
    "globals": "^16.5.0",
    "playwright": "^1.57.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "storybook": "^10.2.11",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.17"
  }
}
